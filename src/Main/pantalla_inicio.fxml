<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>

<Pane prefHeight="116.0" prefWidth="276.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Pantalla_inicioController">

   <children>
      <GridPane hgap="10" layoutX="-9.0" layoutY="-22.0" prefHeight="145.0" prefWidth="299.0" style="-fx-padding: 15;" vgap="10">
         
         <!-- Column layout -->
         <columnConstraints>
            <ColumnConstraints maxWidth="172.0" minWidth="10.0" prefWidth="111.0" />
            <ColumnConstraints maxWidth="246.0" minWidth="10.0" prefWidth="243.0" />
         </columnConstraints>

         <!-- Row layout -->
         <rowConstraints>
            <RowConstraints />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>

         <children>
            <!-- Menú de opciones -->
            <HBox alignment="TOP_RIGHT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <MenuButton mnemonicParsing="false" style="-fx-background-color: #0685bc;" text="Opciones" textFill="WHITE">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#modificarperfil" text="Modificar perfil" />
                        <MenuItem mnemonicParsing="false" text="Cerrar sesión" />
                     </items>
                  </MenuButton>
               </children>
            </HBox>

            <!-- Botón para resolver problema -->
            <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Button mnemonicParsing="false" onAction="#resolverprobl" style="-fx-background-color: #0685bc;" text="Resolver problema" textFill="WHITE" />
               </children>
            </HBox>

            <!-- Botón para ver resultados -->
            <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <Button mnemonicParsing="false" style="-fx-background-color: #0685bc;" text="Ver resultados" textFill="WHITE" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </children>
</Pane>
