<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane style="-fx-background-color: #0685bc;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Main.ResultadosController">
   <children>
      <DatePicker fx:id="datePicker" layoutX="14.0" layoutY="14.0" />
      <TableView fx:id="resultadosTable" layoutX="14.0" layoutY="50.0" prefHeight="180.0" prefWidth="380.0">
         <columns>
            <TableColumn fx:id="fechaColumn" text="Fecha" />
            <TableColumn fx:id="aciertosColumn" text="Aciertos" />
            <TableColumn fx:id="erroresColumn" text="Errores" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
